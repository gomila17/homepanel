# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Proxmox
PROXMOX_BASE_URL=
PROXMOX_TOKEN_ID=homepage@pam!homepage
PROXMOX_TOKEN_SECRET=
# poner en false si el Proxmox usa certificado autofirmado
PROXMOX_VERIFY_SSL=false

# Vikunja
# token creado en Vikunja > Settings > API Tokens (con permiso de lectura sobre tasks/projects)
VIKUNJA_BASE_URL=
VIKUNJA_API_TOKEN=

# AdGuard Home
# mismas credenciales que el login del panel web
ADGUARD_BASE_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Cloudflare Tunnel
# token de API con permiso "Account > Cloudflare Tunnel > Read"
# account id y tunnel id: dashboard Zero Trust > Networks > Tunnels
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=

# Nginx Proxy Manager
# mismas credenciales que el login del panel de NPM
NPM_BASE_URL=
NPM_EMAIL=
NPM_PASSWORD=

# OpenWeatherMap
# API key gratuita (Current Weather Data) en https://openweathermap.org/api
# formato de ubicacion: Ciudad,CodigoPais (ej. Madrid,ES)
OPENWEATHER_API_KEY=
OPENWEATHER_LOCATION=

# Panel de Applications
# array JSON de {"name","kind","url"}; cada app se comprueba en vivo (online/ms) al cargar el panel
APPS_JSON=[{"name":"EXAMPLE APP","kind":"EXAMPLE KIND","url":"https://example.gomila.dev"}]

# Panel de LAN ACCESS (acceso por IP, sin salir a internet)
# array JSON de {"name","url"} con "kind" opcional; si "name" coincide con una app de APPS_JSON
# hereda su nombre y kind, asi solo se definen una vez. Las apps sin equivalente por dominio
# (solo LAN) deben indicar su propio "kind". HTTPS con certificado autofirmado se acepta.
LAN_APPS_JSON=[{"name":"EXAMPLE APP","url":"http://192.0.2.10:8080"},{"name":"LAN ONLY APP","kind":"EXAMPLE KIND","url":"http://192.0.2.11:3001"}]
