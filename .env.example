# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Proxmox
PROXMOX_BASE_URL=
PROXMOX_TOKEN_ID=homepage@pam!homepage
PROXMOX_TOKEN_SECRET=
# poner en false si el Proxmox usa certificado autofirmado
PROXMOX_VERIFY_SSL=false

# Vikunja
# token creado en Vikunja > Settings > API Tokens (con permiso de lectura sobre tasks/projects)
VIKUNJA_BASE_URL=
VIKUNJA_API_TOKEN=

# AdGuard Home
# mismas credenciales que el login del panel web
ADGUARD_BASE_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Cloudflare Tunnel
# token de API con permiso "Account > Cloudflare Tunnel > Read"
# account id y tunnel id: dashboard Zero Trust > Networks > Tunnels
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=

# Nginx Proxy Manager
# mismas credenciales que el login del panel de NPM
NPM_BASE_URL=
NPM_EMAIL=
NPM_PASSWORD=

# OpenWeatherMap
# API key gratuita (Current Weather Data) en https://openweathermap.org/api
# formato de ubicacion: Ciudad,CodigoPais (ej. Madrid,ES)
OPENWEATHER_API_KEY=
OPENWEATHER_LOCATION=
